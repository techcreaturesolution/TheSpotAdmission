NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thespotadmission
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Emails that become platform admins when they register / log in
ADMIN_EMAILS=
# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@thespotadmission.local
SEED_ADMIN_PASSWORD=

# --- Mobile OTP (enquiries, spot-admission alerts, OTP login) ---
# MSG91 OTP API: https://docs.msg91.com/otp  (leave empty to use dev mode)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Dev mode: when no SMS provider is set, the API returns the OTP in the response so you can test.
# Always off when NODE_ENV=production.
OTP_DEV_ECHO=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# --- Uploads (logos, gallery, brochures, application documents) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Same phone + institution within this many hours is merged into one enquiry
DUPLICATE_LEAD_HOURS=24
